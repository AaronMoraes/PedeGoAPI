# Copie este arquivo para ".env" (ele NUNCA vai para o Git) e preencha com valores reais.
# Rodando local com "dotnet run", a API lê o .env sozinha.

# Chave secreta que assina os logins. Mínimo 32 caracteres. Gere uma com:
#   openssl rand -base64 48        (Linux/Mac/Git Bash)
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])   (PowerShell)
JWT_KEY=3A8+RRfvFgJRVdtyox65BcClzDVYqEfgKuEa68wepLZENoOHirEFAPYEuOOC/Sfl

# Login do administrador (criado na primeira execução). Senha: mínimo 10 caracteres.
ADMIN_USUARIO=admin2000
ADMIN_SENHA=admin123456789

# Endereços do site que podem chamar a API, separados por vírgula, sem barra no final.
# Em produção: https://seusite.com.br . Se ficar vazio, só localhost é aceito (bom para testes locais).
ALLOWED_ORIGINS=

# true SOMENTE se a API estiver atrás de proxy reverso (Nginx, Caddy, Cloudflare). Em teste local, false.
BEHIND_PROXY=false

# true = na primeira execução, cria o cardápio de demonstração. false = começa com o cardápio vazio.
CARDAPIO_DEMO=true

# Opcionais (o Docker já define /data):
# DB_PATH=/data/gestaodepedidos.db
# UPLOADS_PATH=/data/uploads
